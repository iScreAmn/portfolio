# Скопируй в .env.local и заполни.
#
# ВАЖНО: NEXT_PUBLIC_* подставляется в бандл на этапе сборки, а не в рантайме.
# Для боевого образа значение передаётся build-аргументом в GitHub Actions —
# менять его в .env на сервере бесполезно, нужна пересборка.

# Адрес Express-бэкенда. В проде — https://api.djcode.ge.
# Локально можно оставить пустым: запросы уйдут на свой же origin, а rewrite
# из next.config.mjs проксирует их на API_PROXY_TARGET.
NEXT_PUBLIC_API_URL=

# Куда next dev проксирует /api. По умолчанию http://127.0.0.1:5050.
API_PROXY_TARGET=

# Любое непустое значение включает трекер в dev-режиме.
NEXT_PUBLIC_ANALYTICS_IN_DEV=
